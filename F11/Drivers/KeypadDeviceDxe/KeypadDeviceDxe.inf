#/** @file
#
#  KeypadDeviceDxe - le Power/Vol-Down do PMIC via SPMI e produz o
#  gEFIDroidKeypadDeviceProtocol (consumido pelo KeypadDxe).
#
#**/

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = KeypadDeviceDxe
  FILE_GUID                      = 3c2d9a17-6b54-4e88-9a0d-1f7c2b6e84a1
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = KeypadDeviceEntryPoint

[Sources]
  KeypadDeviceDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  F11/F11.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  IoLib
  DebugLib

[Protocols]
  gEFIDroidKeypadDeviceProtocolGuid    ## PRODUCES

[Depex]
  TRUE
