#/** @file
#
#  WdtKillerDxe - mantem o APSS watchdog desabilitado continuamente (timer periodico).
#
#**/

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = WdtKillerDxe
  FILE_GUID                      = 7b9e2d44-1c3a-4f08-9a21-6d5e8c0f1a72
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = WdtKillerEntryPoint

[Sources]
  WdtKillerDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  IoLib
  DebugLib

[Protocols]
  gEfiTimerArchProtocolGuid             ## CONSUMES

#
# Disable sincrono na entrada (DEPEX TRUE, cedo). O disabler periodico
# arranca quando o Timer arch protocol aparece (LocateProtocol ou notify).
#
[Depex]
  TRUE
